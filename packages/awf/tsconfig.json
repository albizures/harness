{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"declaration": true,
		"sourceMap": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"skipLibCheck": true,
		"types": ["node"],
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": ["dist"]
}
