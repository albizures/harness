{
	"name": "@albizures/awf",
	"version": "0.2.0",
	"description": "Agent workflow CLI shell.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"awf": "./dist/cli.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./trackers/filesystem": "./dist/trackers/filesystem.js",
		"./manifest": "./dist/manifest/index.js",
		"./manifest/definition": "./dist/manifest/definition.js",
		"./workflow-module": "./dist/workflow-module.js",
		"./workflows/agent-development": "./dist/workflows/agent-development/index.js",
		"./workflows/generic-task": "./dist/workflows/generic-task/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm run test:unit && pnpm run test:integration",
		"test:unit": "vitest run --config vitest.config.ts test/unit",
		"test:integration": "vitest run --config vitest.config.ts test/integration",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"test:vitest": "vitest run --config vitest.config.ts",
		"awf": "node ./dist/cli.js"
	},
	"dependencies": {
		"jiti": "^2.7.0",
		"type-fest": "^5.8.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.10",
		"vitest": "^4.1.10"
	}
}
