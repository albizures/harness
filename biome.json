{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!pnpm-lock.yaml",
			"!skills-lock.json",
			"!**/CHANGELOG.md",
			"!.changeset/*.md"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true
	},
	"assist": {
		"enabled": false
	}
}
